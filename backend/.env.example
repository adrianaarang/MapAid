# Copiar a .env y ajustar. NUNCA commitear .env con datos reales.

DATABASE_PATH=./mapaid.db
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Overpass API (OpenStreetMap) — estado del mapa antes del desastre
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Carpetas de datos (por defecto ../data/raw y ../data/processed)
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed

# Modelo entrenado (se genera con el notebook de Colab)
MODEL_PATH=./ia/modelo_danos.pt
