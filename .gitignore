# proyecto arranque sin descargar nada.
data/raw/*
!data/raw/xbd/
data/processed/*
!data/processed/.gitkeep

# Logs
logs/
*.log

# Sistema operativo / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
