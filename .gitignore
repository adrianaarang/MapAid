# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Base de datos local (cada persona tiene la suya)
*.db
*.db.bak
*.db.backup

# Entorno
.env

# Datos descargados: pesan mucho y se bajan aparte (ver docs/datos.md).
